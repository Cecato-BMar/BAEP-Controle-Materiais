# ============================================================
# SIS LOGÍSTICA 2º BAEP — Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha os valores
# NUNCA comite o arquivo .env no repositório!
# ============================================================

# --- Segurança ---
# Gere uma chave segura com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=coloque-sua-secret-key-aqui

# False em produção, True apenas em desenvolvimento
DEBUG=False

# Endereços IP / domínios que o servidor responde (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost,10.43.19.224,10.43.19.225

# Origens CSRF confiáveis (separadas por vírgula)
CSRF_TRUSTED_ORIGINS=http://10.43.19.224:8000,https://10.43.19.224:8000,http://10.43.19.225:8000,https://10.43.19.225:8000

# --- Banco de dados PostgreSQL ---
# Exemplo: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/reserva_baep
POSTGRES_SSLMODE=prefer

# --- E-mail (produção) ---
# Para produção, use 'django.core.mail.backends.smtp.EmailBackend'
# Para desenvolvimento, deixe 'django.core.mail.backends.console.EmailBackend'
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-app-password-aqui
DEFAULT_FROM_EMAIL=SIS LOGÍSTICA 2ºBAEP <noreply@reservabaep.com.br>
